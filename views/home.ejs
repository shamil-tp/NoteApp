<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Notes</title>

<link rel="stylesheet" href="/bootstrap/bootstrap/css/bootstrap.min.css">

<style>

body{
background:#f5f7fb;
}

.navbar-brand{
font-weight:700;
letter-spacing:1px;
}

.note-form textarea{
border-radius:10px;
}

.card{
border:none;
border-radius:15px;
box-shadow:0 5px 20px rgba(0,0,0,0.05);
}

.table td, .table th{
vertical-align:middle;
}

.note-link{
text-decoration:none;
font-weight:500;
color:#0d6efd;
}

.note-link:hover{
text-decoration:underline;
}

.delete-btn{
padding:4px 10px;
}

</style>
</head>

<body>

<nav class="navbar navbar-dark bg-dark navbar-expand-lg">
<div class="container">

<a class="navbar-brand" href="/">📝 Notes</a>

</div>
</nav>

<div class="container mt-4">

<div class="row g-4">

<!-- CREATE NOTE -->
<div class="col-lg-5 col-12">

<div class="card p-4">

<h4 class="mb-3">Create Note</h4>

<form action="/add" method="post" class="note-form">

<div class="form-floating">

<textarea
class="form-control"
placeholder="Write something..."
id="floatingTextarea2"
style="height:250px"
name="text"
></textarea>

<label for="floatingTextarea2">Write Note</label>

</div>

<div class="d-grid mt-3">

<button class="btn btn-success btn-lg">
Create Note
</button>

</div>

</form>

</div>

</div>


<!-- NOTES TABLE -->
<div class="col-lg-7 col-12">

<div class="card p-4">

<h4 class="mb-3">Your Notes</h4>

<div class="table-responsive">

<table class="table table-hover align-middle">

<thead class="table-light">
<tr>
<th>#</th>
<th>Title</th>
<th>Date</th>
<th>Delete</th>
</tr>
</thead>

<tbody>

<% notes.forEach((element,index)=>{ %>

<tr>

<th scope="row"><%= index+1 %></th>

<td>
<a class="note-link" href="/view/<%=element.id%>">
<%= element.text.split(' ')[0] %>
</a>
</td>

<td><%= element.date %></td>

<td>
<a
href="/delete/<%=element.id%>"
class="btn btn-danger btn-sm delete-btn">
Delete
</a>
</td>

</tr>

<% }) %>

</tbody>

</table>

</div>

</div>

</div>

</div>

</div>

</body>
</html>