<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Notes</title>

<link rel="stylesheet" href="/bootstrap/bootstrap/css/bootstrap.min.css">

<style>

body{
background:#0f172a;
color:white;
font-family:system-ui;
}

/* navbar */

.navbar{
background:#020617;
border-bottom:1px solid #1e293b;
}

.logo{
font-weight:700;
font-size:20px;
letter-spacing:1px;
}

/* layout */

.app{
height:calc(100vh - 60px);
}

.sidebar{
background:#020617;
border-right:1px solid #1e293b;
overflow-y:auto;
}

.editor{
background:#0f172a;
}

/* notes list */

.note-item{
padding:14px 16px;
border-bottom:1px solid #1e293b;
text-decoration:none;
display:block;
color:#cbd5f5;
transition:.2s;
}

.note-item:hover{
background:#1e293b;
color:white;
}

/* textarea */

.note-editor{
background:#020617;
border:none;
color:white;
height:65vh;
resize:none;
padding:20px;
font-size:16px;
}

.note-editor:focus{
outline:none;
}

/* buttons */

.btn-create{
background:#22c55e;
border:none;
}

.btn-create:hover{
background:#16a34a;
}

.delete-btn{
font-size:13px;
float:right;
opacity:.7;
}

.delete-btn:hover{
opacity:1;
}

/* scroll */

::-webkit-scrollbar{
width:6px;
}

::-webkit-scrollbar-thumb{
background:#1e293b;
border-radius:10px;
}

</style>
</head>

<body>

<nav class="navbar px-4 py-3 d-flex justify-content-between">

<div class="logo">📝 Notes</div>

</nav>


<div class="container-fluid app">

<div class="row h-100">

<!-- LEFT NOTES LIST -->

<div class="col-lg-3 sidebar p-0">

<% notes.forEach((element,index)=>{ %>

<div class="note-item">

<a href="/view/<%=element.id%>" class="text-decoration-none text-white">

<%= element.text.split(' ')[0] %>

</a>

<a href="/delete/<%=element.id%>" class="text-danger delete-btn">
delete
</a>

</div>

<% }) %>

</div>


<!-- RIGHT EDITOR -->

<div class="col-lg-9 editor p-5">

<h4 class="mb-4">Create Note</h4>

<form action="/add" method="post">

<textarea
name="text"
class="note-editor form-control"
placeholder="Start writing your note..."
></textarea>

<div class="mt-3">

<button class="btn btn-create px-4 py-2 text-white">

Create Note

</button>

</div>

</form>

</div>

</div>

</div>

</body>
</html>